# Environment Variables for Himalayan Escape (Student Mountain Expedition)
# Replace these values in your local .env or .env.local file

# Database connection (Supabase / PostgreSQL with connection pooling)
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres"

# Private Supabase S3-compatible storage for the public trip gallery
SUPABASE_S3_ENDPOINT="https://yourprojectref.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-northeast-1"
SUPABASE_S3_ACCESS_KEY_ID="your-supabase-s3-access-key-id"
SUPABASE_S3_SECRET_ACCESS_KEY="your-supabase-s3-secret-access-key"
SUPABASE_S3_BUCKET="expedition-gallery"

# Razorpay credentials
RAZORPAY_KEY_ID="rzp_test_YourTestKeyHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# Next Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyHere"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Auth & Cryptographic Signing Secrets (32-byte base64 strings)
NEXTAUTH_SECRET="your-32-byte-base64-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
QR_SIGNING_SECRET="your-32-byte-base64-qr-signing-secret-here"
ADMIN_SESSION_SECRET="your-32-byte-base64-admin-session-secret-here"

# Admin Initial Credentials
ADMIN_DEFAULT_EMAIL="admin@glaescape.in"
ADMIN_DEFAULT_PASSWORD="replace-with-a-long-random-password"
