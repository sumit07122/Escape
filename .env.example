# ==============================================================================
# HIMALAYAN ESCAPE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings -> Environment Variables.
#
# IMPORTANT:
# - NEVER commit real credentials, passwords, or private keys to version control.
# - Distinguish between Development, Preview, and Production environments in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Production & Preview: Use Supabase Transaction Pooler (port 6543) with pgbouncer=true
# to prevent serverless function connection starvation.
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL: Direct session connection (port 5432) used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. APPLICATION CANONICAL URLS
# ------------------------------------------------------------------------------
# Local Development: http://localhost:3000
# Vercel Preview:    https://trip-preview-git-branch.vercel.app
# Vercel Production: https://escape-nine-lake.vercel.app (or custom domain: https://himalayanescape.in)
NEXT_PUBLIC_APP_URL="https://escape-nine-lake.vercel.app"
NEXTAUTH_URL="https://escape-nine-lake.vercel.app"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# For Development & Preview: Use Razorpay Test Mode keys (rzp_test_...)
# For Production: Use Razorpay Live Mode keys (rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_YOUR_LIVE_KEY_ID_HERE"
RAZORPAY_KEY_ID="rzp_live_YOUR_LIVE_KEY_ID_HERE"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET_HERE"

# Razorpay Webhook Secret: Configured under Razorpay Dashboard -> Settings -> Webhooks
# Target Webhook URL: https://[YOUR_DOMAIN]/api/webhooks/razorpay
# Subscribed Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SIGNING_SECRET"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 & PEOPLE API (Google Contacts)
# ------------------------------------------------------------------------------
# Configured in Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript Origins:
#   - http://localhost:3000
#   - https://escape-nine-lake.vercel.app
# Authorized Redirect URIs:
#   - http://localhost:3000/api/auth/google/callback
#   - http://localhost:3000/api/auth/google/contacts/callback
#   - https://escape-nine-lake.vercel.app/api/auth/google/callback
#   - https://escape-nine-lake.vercel.app/api/auth/google/contacts/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 5. SECURITY, SESSIONS & CRYPTOGRAPHIC TOKENS
# ------------------------------------------------------------------------------
# Generate 32-byte high-entropy random secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="GENERATE_HIGH_ENTROPY_32_BYTE_BASE64_SECRET"
ADMIN_SESSION_SECRET="GENERATE_HIGH_ENTROPY_32_BYTE_BASE64_SECRET"
QR_SIGNING_SECRET="GENERATE_HIGH_ENTROPY_32_BYTE_BASE64_SECRET"

# ------------------------------------------------------------------------------
# 6. INITIAL COORDINATOR CREDENTIALS (Admin Portal)
# ------------------------------------------------------------------------------
ADMIN_DEFAULT_EMAIL="admin@glaescape.in"
ADMIN_DEFAULT_PASSWORD="SET_A_SECURE_RANDOM_PASSWORD_FOR_PRODUCTION"

# ------------------------------------------------------------------------------
# 7. OPTIONAL STORAGE & ASSETS (Supabase S3 Bucket for Media)
# ------------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT="https://[YOUR_PROJECT_REF].storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-northeast-1"
SUPABASE_S3_ACCESS_KEY_ID="YOUR_SUPABASE_S3_KEY_ID"
SUPABASE_S3_SECRET_ACCESS_KEY="YOUR_SUPABASE_S3_SECRET_KEY"
SUPABASE_S3_BUCKET="expedition-gallery"

# ------------------------------------------------------------------------------
# 8. ZERO-COMMISSION DEVELOPER UPI & INSTANT UTR VERIFICATION GATEWAY
# ------------------------------------------------------------------------------
# Default Coordinator UPI VPA (Direct 0% MDR routing to account)
DEFAULT_UPI_VPA="8126854850@paytm"
NEXT_PUBLIC_DEFAULT_UPI_VPA="8126854850@paytm"
UPI_PAYEE_NAME="HIMALAYAN ESCAPE"
NEXT_PUBLIC_UPI_PAYEE_NAME="HIMALAYAN ESCAPE"

# Optional Developer Micro-Gateway Integration (UPIGateway.dev / UroPay)
UPI_GATEWAY_API_KEY=""
UPI_GATEWAY_SECRET="TripUpi@2026#SecureWebhook"

